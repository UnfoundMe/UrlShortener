# Copy to .env (gitignored) and fill in real values before running `docker compose up`.

POSTGRES_DB=urlshortener
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Host ports the compose stack publishes to — change if these are already in use locally.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080

ASPNETCORE_ENVIRONMENT=Production

# Public, unauthenticated POST /auth/api-keys for self-serve key creation — no rate limiting or
# email verification, so keep this false except when standing up the stack for testing.
ENABLE_SELF_SERVE_API_KEYS=false
