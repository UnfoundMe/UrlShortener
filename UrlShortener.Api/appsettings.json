{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=urlshortener;Username=postgres;Password=changeme",
    "Redis": "localhost:6379"
  },
  "Auth": {
    "EnableSelfServeApiKeys": false
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
